#!/usr/bin/env bash
# pre-commit git hook — gates direct commits and scans staged content for secrets
# Installed by `exonous setup` (marker: exonous)
# Bypass (emergency only): git commit --no-verify

TOKEN=".claude/.commit-authorized"

# Secret scan. This runs on BOTH paths — with and without the token — because
# the token proves only that /commit-changes created it, not that anything was
# actually inspected. Any process can `touch` it. A gate whose guarantee rests
# on a file existing is not a scan, and this hook used to claim it was one.
#
# gitleaks is optional. When it is absent the hook says so instead of staying
# quiet: a silent skip reads exactly like a clean scan, which is the failure
# this block exists to avoid.
scan_staged() {
  if ! command -v gitleaks >/dev/null 2>&1; then
    echo "[pre-commit] gitleaks not installed — staged content was NOT scanned for secrets."
    echo "[pre-commit]   install: https://github.com/gitleaks/gitleaks#installing"
    return 0
  fi

  if gitleaks git --staged --redact --no-banner >/dev/null 2>&1; then
    return 0
  fi

  echo ""
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo " 🔑  gitleaks found a possible secret in the staged changes."
  echo ""
  # -v prints the finding itself — rule, file, line — instead of only the
  # "leaks found: N" summary. --redact keeps the secret out of the terminal.
  gitleaks git --staged --redact --no-banner -v 2>&1 | grep -vE '^\s*$' | head -20
  echo ""
  echo "  Remove the secret and re-stage. If it is a false positive,"
  echo "  add an allowlist entry to .gitleaks.toml instead of bypassing."
  echo ""
  echo "  Emergency bypass: git commit --no-verify"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""
  return 1
}

if [ -f "$TOKEN" ]; then
  # Token created by /commit-changes skill — allow through, but still scan.
  scan_staged || exit 1
  # One-shot: the token authorizes this commit only. Left on disk it would
  # authorize every later commit and push too.
  rm -f "$TOKEN"
  exit 0
fi

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo " 🚫  Direct git commit is not allowed in this repo."
echo ""
echo "  Use the Claude Code skill instead:"
echo "    /commit-changes"
echo ""
echo "  That skill runs /code-review and /security-review"
echo "  before committing. This hook does not run them —"
echo "  it only requires that the skill was used."
echo ""
echo "  Emergency bypass: git commit --no-verify"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""
exit 1
